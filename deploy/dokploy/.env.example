# Configure separately in each Dokploy Compose resource. Never commit real values.
WEB_IMAGE=ghcr.io/ben-001-sys/tooltrack-web@sha256:replace_with_verified_digest
API_IMAGE=ghcr.io/ben-001-sys/tooltrack-api@sha256:replace_with_verified_digest
WEB_ORIGIN=https://staging.example.com
POSTGRES_USER=tooltrack_staging
POSTGRES_DB=tooltrack_staging
POSTGRES_PASSWORD=replace_with_unique_url_safe_random_password
DATABASE_URL=postgresql://tooltrack_staging:replace_with_unique_url_safe_random_password@postgres:5432/tooltrack_staging
BETTER_AUTH_SECRET=replace_with_unique_random_secret_at_least_32_characters
